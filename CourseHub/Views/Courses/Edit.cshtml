@model Course

@{
    ViewData["Title"] = "Edit Course";
}

<div class="edit-course-wrapper">
    <div class="edit-course-card">

        <h1 class="edit-course-title">Edit Course</h1>
        <p class="edit-course-subtitle">
            Update your course details below.
        </p>

        <form asp-action="Edit" asp-controller="Courses" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        
            <div class="edit-course-actions">
                <button type="submit" class="btn save-btn">
                    💾 Save Changes
                </button>

                <a asp-action="AllCourses" asp-controller="Courses" asp-route-myCreated="true"
                   class="btn cancel-btn">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

