@using System.Security.Claims
@using CourseHub.ViewModels

@model HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
}

<div class="page-title text-center py-4">
    <h1 class="display-4 fw-bold">Welcome to CourseHub</h1>
    <p class="lead">Teach. Learn. Grow.</p>
</div>

<div class="hero-section d-flex align-items-center justify-content-center text-white w-100 p-0 container-fluid mb-5">
    <div class="hero-content text-center px-3">
        <h2 class="display-3 fw-bold mb-3">Unlock New Skills &amp; Inspire Others</h2>
        <p class="lead mb-4 shadow">Join other learners and instructors sharing knowledge and help others.</p>

        @if (!User.Identity?.IsAuthenticated ?? false)
        {
            <a class="btn btn-success btn-lg me-2" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
            <a class="btn btn-outline-light btn-lg" asp-area="Identity" asp-page="/Account/Login">Log In</a>
        }
        else
        {
            <a class="btn btn-primary btn-lg" asp-controller="Courses" asp-action="AllCourses">Browse Courses</a>
            @if (User.IsInRole("Instructor"))
            {
                <div class="mt-4 text-center">
                    <a asp-controller="Courses" asp-action="Create"
                       class="btn btn-lg btn-primary create-course-hero-btn">
                        ➕ Create New Course
                    </a>
                </div>
            }
        }
    </div>
</div>

@if (Model.LatestCourses.Any())
{
    <h2 class="text-2xl font-semibold mt-8 mb-4">Explore Latest Courses</h2>
    <div class="d-flex flex-wrap justify-content-center gap-4">
        @foreach (var course in Model.LatestCourses)
        {
            <div class="rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300">               
                <div class="p-4 course-card">
                    <div class="course-content">
                        <h3 class="text-xl font-bold mb-2">@course.Title</h3>
                        <p class="text-gray-600 mb-3">@course.Description</p>
                        @if (course.Instructor is not null && course.InstructorId != User.FindFirstValue(ClaimTypes.NameIdentifier))
                        {
                            <p class="course-meta text-sm text-gray-500 mb-3">Instructor: @course.Instructor?.DisplayName</p>
                        }
                    </div>
                    <div class="flex flex-wrap gap-2">

                        @if (Model.EnrolledCourses.Any(e => e.Id == course.Id))
                        {
                            <span class="enrolled-badge">
                                Already Enrolled
                            </span>
                        }
                        else if (course.InstructorId != User.FindFirstValue(ClaimTypes.NameIdentifier))
                        {
                            <form asp-controller="Courses" asp-action="Enroll" asp-route-id="@course.Id" method="get">
                                <button class="btn btn-success px-3 py-2 bg-green-500 text-white rounded-lg enroll-btn">Enroll</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<script>
    const alertMessage = document.querySelector('.alert');
    if (alertMessage) {
        setTimeout(() => {
            alertMessage.classList.add('hidden');
            setTimeout(() => alertMessage.style.display = 'none', 400);
        }, 2800);
    }
</script>
